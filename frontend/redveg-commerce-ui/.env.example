# Vite environment variables
# VITE_API_URL should be the base URL of the backend API, including the /api/v1 prefix.
# Example for local development:
# VITE_API_URL=http://localhost:3001/api/v1
#
# In production, set to the production backend URL, e.g.:
# VITE_API_URL=https://your-backend-service.onrender.com/api/v1

# Google reviews use the public Red Veg Google Maps listing and require no API key.

# Firebase Auth project used by the storefront (must match backend FIREBASE_PROJECT_ID)
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-project-sender-id
VITE_FIREBASE_APP_ID=your-firebase-web-app-id
