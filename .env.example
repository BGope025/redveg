# Turso Database URLs and Auth Tokens
TURSO_CATALOG_URL=libsql://your-catalog-db-url.turso.io
TURSO_CATALOG_AUTH_TOKEN=your-catalog-db-auth-token
TURSO_ORDERS_URL=libsql://your-orders-db-url.turso.io
TURSO_ORDERS_AUTH_TOKEN=your-orders-db-auth-token
TURSO_CUSTOMER_URL=libsql://your-customer-db-url.turso.io
TURSO_CUSTOMER_AUTH_TOKEN=your-customer-db-auth-token
AVAILABLE_PINCODES_DB_URL=libsql://your-available-pincodes-db-url.turso.io
AVAILABLE_PINCODES_DB_AUTH_TOKEN=your-available-pincodes-db-auth-token

# Cloudinary Configuration
# Get these from your Cloudinary dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Geoapify reverse geocoding key (server-side only; never expose as VITE_*)
GEOAPIFY_API_KEY=your-geoapify-api-key

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
JWT_EXPIRES_IN=24h

# Transactional email for admin password reset (Resend)
# Configure these on the backend host only. Verify the sender domain in Resend first.
RESEND_API_KEY=re_your_resend_api_key
PASSWORD_RESET_FROM="RedVeg <no-reply@notify.redveg.in>"
APP_PUBLIC_URL=https://redveg.in
PASSWORD_RESET_HASH_SECRET=use-a-long-random-server-only-secret

# Firebase Auth project used by the storefront client; used to verify customer ID tokens
FIREBASE_PROJECT_ID=your-firebase-project-id

# Server Configuration
PORT=3000
TZ=Asia/Kolkata
CORS_ORIGIN=*
TURSO_RETRY_ATTEMPTS=3
TURSO_REQUEST_TIMEOUT_MS=15000

# WhatsApp Configuration
ADMIN_WHATSAPP_NUMBER=+1234567890

# Razorpay Standard Checkout (both values stay on the backend; checkout is enabled when both are set).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PUBLIC_STOREFRONT_URL=https://redveg.in
# Existing owner-approved limit remains in force for online payments.
ONLINE_PAYMENT_MAX_AMOUNT=10


# Data Retention
ARCHIVE_CRON_TIME=0 0 * * *  # Daily at midnight

# File Upload Limits
MAX_FILE_SIZE_MB=5

# Password Hashing
SALT_ROUNDS=10
