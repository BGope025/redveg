{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\anura\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\anura\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Preparing build session"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\anura\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\anura\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f \"C:\\\\Users\\\\anura\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" ] || \"C:\\\\Users\\\\anura\\\\.claude\\\\skills\\\\impeccable\\\\scripts\\\\impeccable\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-bash-check.sh",
            "timeout": 3,
            "statusMessage": "Pre-command security validation"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/hooks/pre-write-check.sh",
            "timeout": 3,
            "statusMessage": "Pre-write secret detection"
          }
        ]
      }
    ]
  },
  "description": "Impeccable design detector: immediate-tier checks after Edit/Write on UI files, full-rule deep pass on Stop. Security hooks: PreToolUse validation for dangerous commands and secret detection via dedicated scripts.",
  "permissions": {
    "allow": [
      "Bash(rtk git *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(npm run*)",
      "Read(*)",
      "Glob(*)",
      "Grep(*)",
      "Task(*)",
      "WebFetch(*)",
      "WebSearch(*)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(sudo *)",
      "Bash(chmod 777 *)",
      "Bash(curl * | *sh*)",
      "Bash(wget * | *bash*)",
      "Bash(nc -*)",
      "Bash(netcat *)",
      "Bash(telnet *)",
      "Bash(sshpass *)",
      "Bash(* > /dev/tcp/*)",
      "Bash(* > /dev/udp/*)",
      "Write(*/.env*)",
      "Write(*/id_rsa*)",
      "Write(*/secrets*)",
      "Write(*/credentials*)"
    ]
  }
}